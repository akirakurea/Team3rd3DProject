## Unity .gitignore Template
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender assets
*.blend1
*.blend1.meta

# Memory / Recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / Editor autogenerated files
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
sysinfo.txt
mono_crash.*

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds & Packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties
InitTestScene*.unity*

# Addressables & Visual Scripting
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/*
/[Aa]ssets/[Ss]ceneDependencyCache*

# Custom & Web/Node Environment
.env
.env.*
node_modules/
build/
dist/

# 패키지 락 파일 충돌이 너무 자주 난다면 아래 줄의 주석(#)을 해제하세요
# Packages/packages-lock.json